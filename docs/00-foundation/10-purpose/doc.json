    "pu-lead": {
      "id": "pu-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Codecaine-AI/archon is a public fork of coleam00/Archon, the workflow engine and scheduler. The fork adds two model node modes, trace tags on each AI node attempt, and the agent kernel as an in-process provider. Everything else stays upstream code. This page says what the fork is, what it changes, and how its commits and docs work."
        }
      ],
      "children": []
    },
    "pu-h-what": {
      "id": "pu-h-what",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What the Fork Is"
        }
      ],
      "children": []
    },
    "pu-what-lead": {
      "id": "pu-what-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The fork tracks upstream Archon, and it moves to a new upstream release only when the maintainers pick that release."
        }
      ],
      "children": []
    },
    "pu-what-1": {
      "id": "pu-what-1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The fork starts from coleam00/Archon at one pinned commit, "
        },
        {
          "insert": "e783f20",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "pu-what-2": {
      "id": "pu-what-2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The repo keeps coleam00/Archon as the "
        },
        {
          "insert": "upstream",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " remote, and the public fork Codecaine-AI/archon is "
        },
        {
          "insert": "origin",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "pu-what-3": {
      "id": "pu-what-3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A rebase moves the fork onto an upstream release. The fork does not take upstream commits between releases."
        }
      ],
      "children": []
    },
    "pu-what-4": {
      "id": "pu-what-4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Every fork commit is public, and that includes each fork-only commit. A fork commit holds no key, no token, and no path from a private machine or workspace."
        }
      ],
      "children": []
    },
