      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Archon is a factory builder. You describe how work should get done as YAML workflows, and Archon runs them with AI agents, scripts and your decisions in the places that need them. Software is the first factory: the bundled "
        },
        {
          "insert": "sdlc",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " pack takes an issue to a merged pull request. The same engine runs any process you can describe."
        }
      ],
      "children": []
    },
