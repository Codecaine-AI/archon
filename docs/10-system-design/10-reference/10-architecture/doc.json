    "b-10-architecture-archon-is-a-bun-and-type-1": {
      "id": "b-10-architecture-archon-is-a-bun-and-type-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Archon is a Bun and TypeScript monorepo. A small set of packages carries the engine and its contracts; the server, CLI, console and integrations compose around them."
        }
      ],
      "children": []
    },
