    "b-25-commands-all-orchestrator-command-1": {
      "id": "b-25-commands-all-orchestrator-command-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "All orchestrator commands available in Archon. Type "
        },
        {
          "insert": "/help",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in your conversation to see this list. On Slack, post an @mention carrying the command in the target thread, for example "
        },
        {
          "insert": "@your-bot /help",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "@your-bot /setproject <name>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Raw orchestrator slash commands are not registered with Slack; "
        },
        {
          "insert": "/archon <message>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " starts a new thread."
        }
      ],
      "children": []
    },
