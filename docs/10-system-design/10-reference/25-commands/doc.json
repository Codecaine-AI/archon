    "table-1-b8e62447": {
      "id": "table-1-b8e62447",
      "type": "structured-table",
      "props": {
        "columns": [
          "Command",
          "Description"
        ],
        "rows": [
          [
            [
              {
                "insert": "/workflow list",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Show available workflows"
          ],
          [
            [
              {
                "insert": "/workflow reload",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Reload workflow definitions"
          ],
          [
            [
              {
                "insert": "/workflow status",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Show active workflows"
          ],
          [
            [
              {
                "insert": "/workflow get <id>",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Show one run, whatever its status"
          ],
          [
            [
              {
                "insert": "/workflow cancel [id]",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "Cancel a running workflow (default: this conversation's). Refuses when no owner answers; check the recorded host and pid, verify the owner has stopped, then use "
              },
              {
                "insert": "/workflow abandon <id>",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            [
              {
                "insert": "/workflow resume <id>",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Resume a failed or paused run (re-runs, skipping completed nodes)"
          ],
          [
            [
              {
                "insert": "/workflow abandon <id>",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "Discard a run (running, paused, or failed) and attempt removal of the worktree it created, keeping the branch. Owner warnings retain the checkout: inspect it ("
              },
              {
                "insert": "lsof",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " when output is still held), resolve the warning, then run abandon again on the cancelled run to retry removal. A silent descendant also retains its checkout and the selected root's checkout, even if the root's owner stopped; each descendant needs its own owner check. If the selected sub-run has no answering endpoint, cancellation succeeds but its subtree's owned checkouts remain: silence does not prove the enclosing execution stopped. Inspect the owning execution and stop or abandon it only if you intend to stop its whole scope; repeated child-only abandonment may still retain the checkouts."
              }
            ]
          ],
          [
            [
              {
                "insert": "/workflow approve <id> [comment]",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "Answer "
              },
              {
                "insert": "approve",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " to a paused run: an attention wait, or a deprecated approval gate (deprecated interactive-loop gates: no comment on a signal-bearing gate = accept & complete; a comment runs another iteration)"
              }
            ]
          ],
          [
            [
              {
                "insert": "/workflow reject <id> [reason]",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "Answer "
              },
              {
                "insert": "reject",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " to a paused run (attention wait or deprecated approval gate). Rejecting an attention wait continues the run with "
              },
              {
                "insert": "decision: reject",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            [
              {
                "insert": "/workflow run <name> [args]",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Run a workflow directly"
          ],
          [
            [
              {
                "insert": "/workflow cleanup [days]",
                "attributes": {
                  "code": true
                }
              }
            ],
            "CLI only -- delete old run records (default: 7 days)"
          ]
        ]
      },
      "children": []
    },
