    "b-10-web-the-web-ui-is-archon-s-b-1": {
      "id": "b-10-web-the-web-ui-is-archon-s-b-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The Web UI is Archon's built-in management console. It uses Archon's public API\nand does not require a separate hosted service."
        }
      ],
      "children": []
    },
    "b-10-web-start-the-console-2": {
      "id": "b-10-web-start-the-console-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Start the console"
        }
      ],
      "children": []
    },
    "b-10-web-for-local-development-s-3": {
      "id": "b-10-web-for-local-development-s-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For local development, start the API server and Vite frontend together:"
        }
      ],
      "children": []
    },
    "b-10-web-bash-4": {
      "id": "b-10-web-bash-4",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "bun run dev"
        }
      ],
      "children": []
    },
    "b-10-web-the-console-is-available-5": {
      "id": "b-10-web-the-console-is-available-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The console is available at "
        },
        {
          "insert": "http://localhost:5173",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; the API server listens on\n"
        },
        {
          "insert": "http://localhost:3090",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-10-web-you-can-also-run-them-se-6": {
      "id": "b-10-web-you-can-also-run-them-se-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "You can also run them separately:"
        }
      ],
      "children": []
    },
    "b-10-web-bash-7": {
      "id": "b-10-web-bash-7",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "bun run dev:server\nbun run dev:web"
        }
      ],
      "children": []
    },
    "b-10-web-for-a-production-build-8": {
      "id": "b-10-web-for-a-production-build-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For a production build, the API server serves the compiled console on port 3090:"
        }
      ],
      "children": []
    },
    "b-10-web-bash-9": {
      "id": "b-10-web-bash-9",
      "type": "code",
      "props": {
        "language": "bash"
      },
