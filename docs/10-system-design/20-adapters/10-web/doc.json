    "b-10-web-authentication-is-option-13": {
      "id": "b-10-web-authentication-is-option-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Authentication is optional. A solo installation with Web authentication disabled\nopens the console directly. When authentication is enabled, the same console\nrequires a session and provides sign-in, signup when allowed by server policy,\nand sign-out."
        }
      ],
      "children": []
    },
