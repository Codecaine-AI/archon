        }
      ],
      "children": []
    },
    "b-10-web-the-backend-binds-to-0-10": {
      "id": "b-10-web-the-backend-binds-to-0-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The backend binds to "
        },
        {
          "insert": "0.0.0.0",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " by default. The Vite development server binds to\nlocalhost; pass "
        },
        {
          "insert": "--host 0.0.0.0",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " only when you intentionally want to expose it:"
        }
      ],
      "children": []
    },
    "b-10-web-bash-11": {
      "id": "b-10-web-bash-11",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
