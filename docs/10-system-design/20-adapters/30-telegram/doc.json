    "b-30-telegram-select-a-registered-proj-23": {
      "id": "b-30-telegram-select-a-registered-proj-23",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Select a registered project by submitting "
        },
        {
          "insert": "/setproject <name>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in the conversation or thread where you want to work. To register a local directory first, submit "
        },
        {
          "insert": "/register-project [--folder] <name> <path>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", then select it; registration alone does not bind the conversation. Projectless questions still work. Selection applies to that conversation, not every channel."
        }
      ],
      "children": []
    },
    "b-30-telegram-once-scoped-the-assista-24": {
      "id": "b-30-telegram-once-scoped-the-assista-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Once scoped, the assistant launches and manages runs through its native tools (Claude, Codex, Pi) or the existing CLI (Copilot/OpenCode). CLI launches are detached and headless, use CLI identity and return a run ID for inspection; they do not deliver progress or results to the originating chat. See "
        },
        {
          "insert": "Deprecated providers",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/30-authoring/10-getting-started/40-ai-assistants.md",
              "section": "deprecated-providers",
              "label": "Deprecated providers"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
