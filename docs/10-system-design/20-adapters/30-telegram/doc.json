    "b-30-telegram-connect-archon-to-telegr-1": {
      "id": "b-30-telegram-connect-archon-to-telegr-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Connect Archon to Telegram so you can interact with your AI coding assistant from any Telegram client."
