    "b-30-telegram-deprecated-2": {
      "id": "b-30-telegram-deprecated-2",
      "type": "callout",
      "props": {
        "title": "Deprecated",
        "tone": "warning"
      },
      "text": [
        {
          "insert": "The Telegram adapter is deprecated: no Archon maintainer owns it. It stays bundled and keeps working, and no removal is scheduled, but fixes are not guaranteed. The server logs a deprecation notice when it starts the adapter. For a version you control, build and own it as a "
        },
        {
          "insert": "chat plugin",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/30-authoring/20-guides/80-publishing-plugins.md",
              "section": "chat-plugins",
              "label": "chat plugin"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-30-telegram-new-identities-are-creat-3": {
      "id": "b-30-telegram-new-identities-are-creat-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "New identities are created as members. The operator can designate admins with "
        },
        {
          "insert": "archon user role <id> admin",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "doc",
              "path": "docs/10-system-design/10-reference/65-security.md",
              "section": "users-and-roles",
              "label": "`archon user role <id> admin`"
            }
          }
        },
        {
          "insert": "; only a run's starter or an admin can act on it. See "
        },
        {
          "insert": "Who can act on a run",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/10-system-design/10-reference/65-security.md",
              "section": "who-can-act-on-a-run",
              "label": "Who can act on a run"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
