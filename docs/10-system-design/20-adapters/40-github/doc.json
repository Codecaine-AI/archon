        "language": "bash"
      },
      "text": [
        {
          "insert": "# Get your existing webhook secret\nWEBHOOK_SECRET=$(grep WEBHOOK_SECRET .env | cut -d= -f2)\n\n# Add webhook to new repo (replace OWNER/REPO)\ngh api repos/OWNER/REPO/hooks --method POST \\\n  -f \"config[url]=https://YOUR_DOMAIN/webhooks/github\" \\\n  -f \"config[content_type]=json\" \\\n  -f \"config[secret]=$WEBHOOK_SECRET\" \\\n  -f \"events[]=check_run\" \\\n  -f \"events[]=issues\" \\\n  -f \"events[]=issue_comment\" \\\n  -f \"events[]=pull_request\""
        }
