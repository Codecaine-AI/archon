    "b-30-gitlab-first-mention-reuses-44": {
      "id": "b-30-gitlab-first-mention-reuses-44",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "First mention",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " reuses an existing local registration at its saved checkout path; otherwise it registers and clones the repository. It detects "
        },
        {
          "insert": ".archon/commands/",
