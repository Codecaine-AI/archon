    "nm-yaml": {
      "id": "nm-yaml",
      "type": "code",
      "props": {
        "language": "yaml"
      },
      "text": [
        {
          "insert": "name: email-intake\ndescription: Route, extract, classify, then reply or change code.\ninputs:\n  message_id: { required: true }\n  raw: { required: true }\n\nnodes:\n  - id: route\n    bash: |\n      echo \"$INPUTS_RAW\" | jq -c '{lane: (if .to == \"support@acme.dev\" then \"support\" else \"other\" end)}'\n\n  - id: extract\n    depends_on: [route]\n    when: \"$route.output.lane == 'support'\"\n    extract:\n      function: ExtractSupportEmail\n      input: $INPUTS.raw\n    tier: fast\n    retries: 2\n    output_format:\n      type: object\n      properties: { sender: { type: string }, ask: { type: string } }\n      required: [sender, ask]\n\n  - id: classify\n    depends_on: [extract]\n    decide:\n      question: What does this email ask for?\n      enum: [reply, code_change, ignore, other]\n      input: $extract.output\n\n  - id: draft-reply\n    depends_on: [classify]\n    when: \"$classify.output.choice == 'reply'\"\n    provider: agent-kernel\n    model: email-reply-drafter\n    prompt: $extract.output\n\n  - id: code-change\n    depends_on: [classify]\n    when: \"$classify.output.choice == 'code_change'\"\n    provider: claude\n    prompt: Make the change this email asks for. $extract.output"
        }
      ],
      "children": []
    }
