    "nm-lead": {
      "id": "nm-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The fork adds two node modes to the Archon DAG grammar. An "
        },
        {
          "insert": "extract",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " node makes one typed model call, and a "
        },
        {
          "insert": "decide",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " node classifies its input into one value of an enum. Neither mode runs an agent turn. Upstream Archon has no typed-extraction node and no classify node."
        }
      ],
      "children": []
    },
