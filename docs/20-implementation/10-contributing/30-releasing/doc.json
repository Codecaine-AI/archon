    "b-30-releasing-note-private-reposito-32": {
      "id": "b-30-releasing-note-private-reposito-32",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Note: Private Repository Installation",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": "\n\nIf the repository is private, the curl install script won't work for anonymous users.\nUse the GitHub CLI instead:\n\n"
        },
        {
          "insert": "bash\n# Download and install using gh (requires GitHub authentication)\ngh release download v0.2.0 --repo coleam00/Archon \\\n  --pattern \"archon-$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m | sed 's/x86_64/x64/;s/aarch64/arm64/')\" \\\n  --dir /tmp/archon-install\n\n# Install the binary\nchmod +x /tmp/archon-install/archon-*\nsudo mv /tmp/archon-install/archon-* /usr/local/bin/archon\n\n# Verify\narchon version\n",
          "attributes": {
            "code": true
          }
        }
      ],
      "children": []
    },
