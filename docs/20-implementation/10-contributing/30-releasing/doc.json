    "b-30-releasing-bash-35": {
      "id": "b-30-releasing-bash-35",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "# 1. Build binaries locally (every target in the script's local TARGETS list).\n#    TARGET or OUTFILE left set in the shell switches the script to single-target mode.\nunset TARGET OUTFILE\n./scripts/build-binaries.sh\n\n# 2. Generate checksums.txt, which the install scripts verify against\n./scripts/checksums.sh\n\n# 3. Create the release with binaries and checksums\ngh release create vX.Y.Z dist/binaries/* \\\n  --title \"Archon CLI vX.Y.Z\" \\\n  --generate-notes\n\n# 4. Verify the release\ngh release view vX.Y.Z"
        }
      ],
      "children": []
    },
    "b-30-releasing-note-with-target-36": {
      "id": "b-30-releasing-note-with-target-36",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Note:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " With "
        },
        {
          "insert": "TARGET",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "OUTFILE",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " unset, "
        },
        {
          "insert": "scripts/build-binaries.sh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " cross-compiles\nthe CLI and server executables for every target in its local "
        },
        {
          "insert": "TARGETS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " list into\n"
        },
        {
          "insert": "dist/binaries/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". That list has no Windows target.\n\nA manual release is therefore incomplete. It lacks the assets only the CI release\nbuilds: the Windows binaries, the plugin executables ("
        },
        {
          "insert": "archon plugin add",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "\ndownloads these), and "
        },
        {
          "insert": "archon-web.tar.gz",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " ("
        },
        {
          "insert": "archon serve",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " downloads it). The "
        },
        {
          "insert": "files:",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "\nlist of the release step in "
        },
        {
          "insert": ".github/workflows/release.yml",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the full set CI publishes."
        }
      ],
      "children": []
    },
    "b-30-releasing-manual-build-for-testin-37": {
