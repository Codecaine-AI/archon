    "b-40-dx-quirks-full-package-runs-start-31": {
      "id": "b-40-dx-quirks-full-package-runs-start-31",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Full package runs start groups slowest first, by the times in "
        },
        {
          "insert": "scripts/test-weights.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Requested runs start groups in resolver order. CI splits slow shards into parts with "
        },
        {
          "insert": "ARCHON_TEST_PART=<index>/<count>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", using the same times; "
        },
        {
          "insert": "ARCHON_TEST_PART=1/2 bun run test",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in a package runs that part locally. A new group with no recorded time counts as one second, so refresh the file with "
        },
        {
          "insert": "bun scripts/update-test-weights.ts <run-id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " when one part of a shard finishes well after its sibling"
        }
      ],
      "children": []
    },
