    "b-40-dx-quirks-when-adding-a-new-test-f-28": {
      "id": "b-40-dx-quirks-when-adding-a-new-test-f-28",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "When adding a new test file with "
        },
        {
          "insert": "mock.module()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to "
        },
        {
          "insert": "packages/core",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", make its first line exactly "
        },
        {
          "insert": "// @archon-test-isolated",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " so it runs in its own process. Core discovers its tests, and discovery fails on a file that calls "
        },
        {
          "insert": "mock.module()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " without the marker. A file that mocks through a helper needs the marker too; discovery cannot see that call"
        }
      ],
      "children": []
    },
