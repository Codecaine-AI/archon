    "b-40-dx-quirks-bun-s-mock-module-is-24": {
      "id": "b-40-dx-quirks-bun-s-mock-module-is-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Bun's "
        },
        {
          "insert": "mock.module()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is process-global and irreversible: "
        },
        {
          "insert": "mock.restore()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " does NOT undo it."
        }
      ],
      "children": []
    },
    "b-40-dx-quirks-never-add-afterall-25": {
      "id": "b-40-dx-quirks-never-add-afterall-25",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Never add "
        },
        {
          "insert": "afterAll(() => mock.restore())",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for "
        },
        {
          "insert": "mock.module()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " cleanup: it has no effect"
        }
      ],
      "children": []
    },
    "b-40-dx-quirks-use-spyon-for-intern-26": {
      "id": "b-40-dx-quirks-use-spyon-for-intern-26",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Use "
        },
        {
          "insert": "spyOn()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for internal modules that other test files import directly (e.g., "
        },
        {
          "insert": "spyOn(git, 'checkout')",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "): "
        },
        {
          "insert": "spy.mockRestore()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " DOES work for spies"
        }
      ],
      "children": []
    },
    "b-40-dx-quirks-never-mock-module-a-27": {
      "id": "b-40-dx-quirks-never-mock-module-a-27",
