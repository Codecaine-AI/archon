    "b-10-local-if-the-port-is-taken-fi-13": {
      "id": "b-10-local-if-the-port-is-taken-fi-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "If the port is taken, find the process with "
        },
        {
          "insert": "lsof -i :3090",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on macOS or Linux, or "
        },
        {
          "insert": "netstat -ano | findstr :3090",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on Windows, or start on another port with "
        },
        {
          "insert": "--port",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
