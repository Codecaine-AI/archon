    "b-10-local-with-an-installed-binary-3": {
      "id": "b-10-local-with-an-installed-binary-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "With an installed binary:"
        }
      ],
      "children": []
    },
    "b-10-local-bash-4": {
      "id": "b-10-local-bash-4",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "archon serve                 # API and Web UI on http://localhost:3090\narchon serve --port 4000     # another port"
        }
      ],
      "children": []
    },
    "b-10-local-a-binary-install-downloa-5": {
      "id": "b-10-local-a-binary-install-downloa-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A binary install downloads the server and Web UI on the first run. "
        },
        {
          "insert": "archon serve --download-only",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " fetches them without starting."
        }
      ],
      "children": []
    },
    "b-10-local-from-a-source-checkout-6": {
      "id": "b-10-local-from-a-source-checkout-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "From a source checkout, "
        },
        {
          "insert": "bun run dev",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " starts the API on port 3090 and the Vite dev server for the Web UI on port 5173; see the "
        },
        {
          "insert": "new developer guide",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/20-implementation/10-contributing/10-new-developer-guide.md",
              "label": "new developer guide"
            }
          }
        },
        {
          "insert": ". A run inside a worktree gets an automatic port from 3190 to 4089, based on the path. "
        },
        {
          "insert": "PORT",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " overrides the port in any context."
        }
      ],
      "children": []
    },
