    "b-10-local-the-cli-needs-no-server-1": {
      "id": "b-10-local-the-cli-needs-no-server-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The CLI needs no server. Run the server when you want the Web UI, chat adapters or webhooks. For a VPS with HTTPS, see "
        },
        {
          "insert": "Cloud Deployment",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/20-implementation/20-deployment/30-cloud.md",
              "label": "Cloud Deployment"
            }
          }
        },
        {
          "insert": "; for containers, see "
        },
        {
          "insert": "Docker",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/20-implementation/20-deployment/20-docker.md",
              "label": "Docker"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
