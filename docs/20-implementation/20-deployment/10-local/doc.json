    "b-10-local-sqlite-stores-data-at-11": {
      "id": "b-10-local-sqlite-stores-data-at-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "SQLite stores data at "
        },
        {
          "insert": "~/.archon/archon.db",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and creates it on first run. For a local PostgreSQL container, run "
        },
        {
          "insert": "docker compose --profile with-db up -d postgres",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " from a source checkout and set "
        },
        {
          "insert": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/remote_coding_agent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The server creates and upgrades the schema on startup. See "
        },
        {
          "insert": "Database",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/10-system-design/10-reference/40-database.md",
              "label": "Database"
            }
          }
        },
        {
          "insert": "."
        }
