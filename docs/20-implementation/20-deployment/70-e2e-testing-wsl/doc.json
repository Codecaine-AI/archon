    "b-70-e2e-testing-wsl-screenshots-must-be-save-21": {
      "id": "b-70-e2e-testing-wsl-screenshots-must-be-save-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Screenshots must be saved to a WSL-native path first, then copied to the Windows filesystem via the "
        },
        {
          "insert": "/mnt/c/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " mount:"
        }
      ],
      "children": []
    },
    "b-70-e2e-testing-wsl-bash-22": {
      "id": "b-70-e2e-testing-wsl-bash-22",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "# Save to WSL home, then copy to project\nwsl -d Ubuntu -- bash -c '\n  agent-browser screenshot /home/user/screenshot.png 2>&1 &&\n  cp /home/user/screenshot.png /path/to/archon/e2e-screenshots/my-test.png\n'"
        }
      ],
      "children": []
    },
    "b-70-e2e-testing-wsl-why-not-save-directly-23": {
      "id": "b-70-e2e-testing-wsl-why-not-save-directly-23",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why not save directly to ",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": "/mnt/c/...",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "?",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " agent-browser resolves paths through its Node.js process, which on some setups mangles "
        },
        {
          "insert": "/mnt/c/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " paths (e.g., prepending "
        },
        {
          "insert": "C:/Program Files/Git/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). Saving to a WSL-native path and copying avoids this."
        }
      ],
      "children": []
    },
