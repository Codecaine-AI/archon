      "id": "b-70-e2e-testing-wsl-bash-14",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "# Backend (Hono on port 3090) - already binds to 0.0.0.0 by default\nbun run dev:server &\n\n# Frontend (Vite on port 5173) - needs --host flag\ncd packages/web && bun x vite --host 0.0.0.0 &"
