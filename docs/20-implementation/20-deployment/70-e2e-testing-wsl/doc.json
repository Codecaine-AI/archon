        {
          "insert": "C:/Program Files/Git/status",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " when passed through Git Bash. Not an agent-browser issue; it's the shell expanding "
        },
        {
          "insert": "/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " paths"
