    "b-70-e2e-testing-wsl-all-commands-are-run-fro-18": {
      "id": "b-70-e2e-testing-wsl-all-commands-are-run-fro-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "All commands are run from the Windows terminal, prefixed with "
        },
        {
          "insert": "wsl -d Ubuntu --",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ":"
        }
      ],
      "children": []
    },
    "b-70-e2e-testing-wsl-bash-19": {
      "id": "b-70-e2e-testing-wsl-bash-19",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "# Open a page\nwsl -d Ubuntu -- agent-browser open http://172.18.64.1:5173\n\n# Take interactive snapshot (get element refs like @e1, @e2)\nwsl -d Ubuntu -- agent-browser snapshot -i\n\n# Click, fill, press\nwsl -d Ubuntu -- agent-browser click @e1\nwsl -d Ubuntu -- agent-browser fill @e2 \"some text\"\nwsl -d Ubuntu -- agent-browser press Enter\n\n# Wait for content to load\nwsl -d Ubuntu -- agent-browser wait 3000\n\n# Reload page (hard refresh)\nwsl -d Ubuntu -- agent-browser reload\n\n# Close browser\nwsl -d Ubuntu -- agent-browser close"
        }
      ],
      "children": []
    },
