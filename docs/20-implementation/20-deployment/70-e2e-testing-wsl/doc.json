    "b-70-e2e-testing-wsl-agent-browser-vercel-1": {
      "id": "b-70-e2e-testing-wsl-agent-browser-vercel-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "agent-browser",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (Vercel) has a "
        },
        {
          "insert": "known Windows bug",
          "attributes": {
            "link": "https://github.com/vercel-labs/agent-browser/issues/56"
          }
        },
        {
          "insert": " where the daemon fails to start due to Unix domain socket incompatibility. The workaround is to run agent-browser inside WSL while the dev servers run on Windows."
        }
      ],
      "children": []
