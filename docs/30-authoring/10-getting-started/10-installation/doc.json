        {
          "insert": "# macOS / Linux / WSL (Anthropic's recommended installer)\ncurl -fsSL https://claude.ai/install.sh | bash\n\n# Windows (PowerShell)\nirm https://claude.ai/install.ps1 | iex"
        }
      ],
      "children": []
    },
    "b-10-installation-the-installed-claude-pro-35": {
      "id": "b-10-installation-the-installed-claude-pro-35",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The installed Claude provider finds Claude Code at the native installer's path ("
        },
        {
          "insert": "~/.local/bin/claude",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or "
        },
        {
          "insert": "%USERPROFILE%\\.local\\bin\\claude.exe",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on Windows) without configuration. Source installs ("
        },
        {
          "insert": "bun run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") find it through "
        },
        {
          "insert": "node_modules",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". For any other install, such as "
        },
        {
          "insert": "npm install -g @anthropic-ai/claude-code",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", point Archon at it:"
        }
      ],
      "children": []
    },
