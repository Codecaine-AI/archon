          "insert": "The source-install and "
        },
        {
          "insert": "bun link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " workflow is for terminal development and\nrequires Bun on "
        },
        {
          "insert": "PATH",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
