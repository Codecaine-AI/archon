    "b-10-installation-bash-4": {
      "id": "b-10-installation-bash-4",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "curl -fsSL https://archon.diy/install | bash\n\n# Choose providers without the question\ncurl -fsSL https://archon.diy/install | bash -s -- --providers codex"
        }
      ],
      "children": []
    },
    "b-10-installation-x64-compatibility-c-5": {
      "id": "b-10-installation-x64-compatibility-c-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "x64 compatibility:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Compiled x64 binaries require AVX2. Older Intel/AMD\nhardware and virtual machines that mask AVX2 cannot use the x64 quick install;\nuse "
        },
        {
          "insert": "From Source",
          "attributes": {
            "link": "#from-source"
          }
        },
        {
          "insert": " instead. ARM64 quick installs are unaffected."
        }
      ],
      "children": []
    },
