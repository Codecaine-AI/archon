    "b-10-installation-release-binaries-ship-wi-2": {
      "id": "b-10-installation-release-binaries-ship-wi-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Release binaries ship without AI providers. The quick installers ask which of\nClaude, Codex and Pi to add and run "
        },
        {
          "insert": "archon provider add",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for your\nselection; Homebrew prints the command instead. See "
        },
        {
          "insert": "Providers",
          "attributes": {
            "link": "#providers"
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-10-installation-macos-linux-3": {
