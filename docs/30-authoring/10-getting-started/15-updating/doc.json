    "b-15-updating-commit-or-stash-your-cha-21": {
      "id": "b-15-updating-commit-or-stash-your-cha-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Commit or stash your changes before updating. The "
        },
        {
          "insert": "main",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " branch contains releases;\n"
        },
        {
          "insert": "dev",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the working development branch."
        }
      ],
      "children": []
    },
    "b-15-updating-bash-22": {
      "id": "b-15-updating-bash-22",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "git switch main\ngit pull --ff-only\nbun install --frozen-lockfile\nbun run cli version"
        }
      ],
      "children": []
    },
    "b-15-updating-if-you-serve-the-console-23": {
      "id": "b-15-updating-if-you-serve-the-console-23",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "If you serve the console from source, rebuild it with "
        },
        {
          "insert": "bun run build:web",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " before\nrestarting your server."
        }
      ],
      "children": []
    },
    "b-15-updating-update-notices-24": {
