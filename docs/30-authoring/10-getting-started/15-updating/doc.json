    "b-15-updating-compiled-cli-installs-ch-25": {
      "id": "b-15-updating-compiled-cli-installs-ch-25",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Compiled CLI installs check for updates in the background during "
        },
        {
          "insert": "workflow run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "\nand "
        },
        {
          "insert": "workflow resume",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". When fresh release data is available, they print update\ninstructions to stderr at most once every 24 hours, even when the command fails.\n"
        },
        {
          "insert": "--quiet",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "--json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " suppress this notice. An unavailable network or stale cache\ndoes not delay the command."
        }
      ],
      "children": []
    },
    "b-15-updating-the-console-shows-a-bann-26": {
      "id": "b-15-updating-the-console-shows-a-bann-26",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The console shows a banner when a newer release is available. Dismissing it is\nremembered in your browser for that release; a later release shows the banner again."
        }
      ],
      "children": []
