    "b-15-updating-for-the-release-image-sh-14": {
      "id": "b-15-updating-for-the-release-image-sh-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For the release image shown in the installation guide, pull the new image before\nstarting another container:"
        }
      ],
      "children": []
    },
    "b-15-updating-bash-15": {
      "id": "b-15-updating-bash-15",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "docker pull ghcr.io/coleam00/archon:latest\ndocker run --rm -v \"$PWD:/workspace\" ghcr.io/coleam00/archon:latest version"
        }
      ],
      "children": []
    },
    "b-15-updating-for-a-long-running-conta-16": {
      "id": "b-15-updating-for-a-long-running-conta-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For a long-running container, stop and recreate it using the same volumes,\nenvironment, and ports as the original container. Restarting an existing container\ndoes not change its image. Keep your data volumes."
        }
      ],
      "children": []
    },
    "b-15-updating-the-repository-s-docker-17": {
      "id": "b-15-updating-the-repository-s-docker-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The repository's Docker Compose deployment builds from source. Follow its\n"
        },
        {
          "insert": "update instructions",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/20-implementation/20-deployment/20-docker.md",
              "section": "update",
              "label": "update instructions"
            }
          }
        },
        {
          "insert": ", retaining the profiles you\nused for deployment; rebuilding and recreating the app loads the updated source."
        }
      ],
      "children": []
    },
