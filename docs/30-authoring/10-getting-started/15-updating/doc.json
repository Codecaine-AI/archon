    "b-15-updating-use-the-same-method-you-1": {
      "id": "b-15-updating-use-the-same-method-you-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Use the same method you used to "
        },
        {
          "insert": "install Archon",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/30-authoring/10-getting-started/10-installation.md",
              "label": "install Archon"
            }
          }
        },
        {
          "insert": ".\nRead the "
        },
        {
          "insert": "release notes",
          "attributes": {
            "link": "https://github.com/coleam00/Archon/releases"
          }
        },
        {
          "insert": " before updating.\nLet active workflows finish and stop any running Archon server before replacing\nits executable or source checkout. Restart the server afterward so the console\nand new runs use the updated version."
        }
      ],
      "children": []
    },
    "b-15-updating-a-release-binary-checks-2": {
      "id": "b-15-updating-a-release-binary-checks-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A release binary checks that each installed provider matches its own version.\nAfter a Homebrew or quick-installer update, reinstall the providers you use\n(the quick installer asks; Homebrew does not):"
        }
      ],
      "children": []
    },
    "b-15-updating-bash-3": {
      "id": "b-15-updating-bash-3",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "archon provider add claude codex   # the providers you use"
        }
      ],
      "children": []
    },
    "b-15-updating-until-you-do-a-run-that-4": {
      "id": "b-15-updating-until-you-do-a-run-that-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Until you do, a run that needs one fails before it starts and prints this\ncommand. "
        },
        {
          "insert": "archon doctor",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " lists each provider's installed version. Docker and\nsource installs run providers from source and skip this step."
        }
      ],
      "children": []
    },
    "b-15-updating-homebrew-5": {
      "id": "b-15-updating-homebrew-5",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
