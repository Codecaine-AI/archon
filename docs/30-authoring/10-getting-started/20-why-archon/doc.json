    "b-20-why-archon-a-when-condition-skip-14": {
      "id": "b-20-why-archon-a-when-condition-skip-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A "
        },
        {
          "insert": "when:",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " condition skips a node based on earlier output, and "
        },
        {
          "insert": "output_format",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " makes an agent return JSON that later nodes can branch on. The rule of thumb is: YAML coordinates, code computes, agents judge."
        }
      ],
      "children": []
    },
    "b-20-why-archon-nodes-hand-work-to-each-15": {
      "id": "b-20-why-archon-nodes-hand-work-to-each-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Nodes hand work to each other through "
        },
        {
          "insert": "artifacts",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", files in the run's "
        },
        {
          "insert": "$ARTIFACTS_DIR",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A node can start a fresh agent session with "
        },
        {
          "insert": "context: fresh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and read only the artifacts it needs, so each step stays focused."
        }
      ],
      "children": []
    },
    "b-20-why-archon-isolation-a-run-aga-16": {
      "id": "b-20-why-archon-isolation-a-run-aga-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Isolation.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " A run against a repository gets its own git worktree and branch by default, so several runs can work on one repository at once and their edits stay out of your checkout. A worktree separates checkouts. It is not a security sandbox. See "
        },
        {
          "insert": "Run work in parallel with worktrees",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/30-authoring/20-guides/15-worktrees.md",
              "label": "Run work in parallel with worktrees"
            }
          }
        },
        {
          "insert": ". A directory registered as a "
        },
        {
          "insert": "folder project",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/30-authoring/20-guides/65-multi-repo-projects.md",
              "label": "folder project"
            }
          }
        },
        {
          "insert": " runs in place instead."
        }
      ],
      "children": []
    },
    "b-20-why-archon-packs-and-plugins-a-17": {
      "id": "b-20-why-archon-packs-and-plugins-a-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Packs and plugins.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " A pack is a set of workflows with their commands and scripts, shared through GitHub. Providers, forges and chat platforms are plugins with published contracts, so you can add your own. See "
        },
        {
          "insert": "Publish a plugin",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/30-authoring/20-guides/80-publishing-plugins.md",
              "label": "Publish a plugin"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
