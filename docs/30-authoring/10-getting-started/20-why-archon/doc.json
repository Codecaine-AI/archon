    "b-20-why-archon-archon-is-a-factory-buil-1": {
      "id": "b-20-why-archon-archon-is-a-factory-buil-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Archon is a factory builder. You describe how work should get done as YAML workflows, and Archon runs them with AI agents, scripts and your decisions in the places that need them. Software is the first factory: the bundled "
        },
        {
          "insert": "sdlc",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " pack takes an issue to a merged pull request. The same engine runs any process you can describe."
        }
      ],
      "children": []
    },
    "b-20-why-archon-the-problem-it-solves-2": {
      "id": "b-20-why-archon-the-problem-it-solves-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The problem it solves"
        }
      ],
      "children": []
    },
    "b-20-why-archon-ask-a-coding-agent-to-fi-3": {
      "id": "b-20-why-archon-ask-a-coding-agent-to-fi-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Ask a coding agent to fix a bug and the result depends on the run. It may skip the plan, forget the tests or ignore your pull request template. Your process lives in the model's head, so you supervise every step."
        }
      ],
      "children": []
    },
    "b-20-why-archon-archon-moves-the-process-4": {
      "id": "b-20-why-archon-archon-moves-the-process-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Archon moves the process into a file you own. The workflow fixes the steps, the checks and the gates. The agent supplies judgment inside each step. You get:"
        }
      ],
      "children": []
    },
    "b-20-why-archon-the-same-process-every-5": {
      "id": "b-20-why-archon-the-same-process-every-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The same process every time.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Plan, implement, review, validate and open the pull request, in the order you wrote down."
        }
      ],
      "children": []
    },
    "b-20-why-archon-human-on-the-loop-not-6": {
      "id": "b-20-why-archon-human-on-the-loop-not-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Human on the loop, not in it.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " You take yourself out of the loop and sit on top of it. Queues move work forward on their own. When a run reaches a decision it can't make, it pauses as one "
        },
        {
          "insert": "attention item",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/30-authoring/10-getting-started/50-operate.md",
              "label": "attention item"
            }
          }
        },
        {
          "insert": ": what it is, why it matters, a recommendation and the choices. You answer and it carries on."
        }
      ],
      "children": []
    },
    "b-20-why-archon-governance-built-in-7": {
      "id": "b-20-why-archon-governance-built-in-7",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Governance built in.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Approval gates, an event log and transcript for every run, and the cost of every run, stored in your own database."
        }
      ],
      "children": []
    },
    "b-20-why-archon-your-agents-and-subscr-8": {
      "id": "b-20-why-archon-your-agents-and-subscr-8",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Your agents and subscriptions.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Archon runs Claude Code, Codex and Pi through their own CLIs and SDKs, with the accounts and project guidance you already have."
        }
      ],
      "children": []
    },
    "b-20-why-archon-self-hosted-one-ins-9": {
      "id": "b-20-why-archon-self-hosted-one-ins-9",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Self-hosted.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " One install on your machine or server. SQLite by default, PostgreSQL if you want it."
        }
      ],
      "children": []
    },
    "b-20-why-archon-core-concepts-10": {
