    "b-20-why-archon-a-workflow-is-a-yaml-11": {
      "id": "b-20-why-archon-a-workflow-is-a-yaml-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A "
        },
        {
          "insert": "workflow",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " is a YAML file in "
        },
        {
          "insert": ".archon/workflows/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It lists "
        },
        {
          "insert": "nodes",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " and the dependencies between them, and Archon runs them as a graph. Nodes without a dependency between them normally run in parallel. "
        },
        {
          "insert": "Loop bodies settle ordinary work before interactions",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/30-authoring/20-guides/20-loop-nodes.md",
              "section": "how-it-works",
              "label": "Loop bodies settle ordinary work before interactions"
            }
          }
        },
        {
          "insert": "; checkout guards can also require sequential execution."
        }
      ],
      "children": []
    },
    "b-20-why-archon-each-node-does-one-thing-12": {
      "id": "b-20-why-archon-each-node-does-one-thing-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each node does one thing:"
        }
      ],
      "children": []
    },
