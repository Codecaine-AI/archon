    "b-20-why-archon-archon-v1-to-v6-2024-to-20": {
      "id": "b-20-why-archon-archon-v1-to-v6-2024-to-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Archon v1 to v6 (2024 to early 2025) was a different product: an AI agent builder with Supabase, RAG and direct LLM API calls. The current 0.x series is a rewrite, and archon.diy documents only 0.x. The old product is on the unmaintained "
        },
        {
          "insert": "archive/v1-stable",
          "attributes": {
            "code": true,
            "link": "https://github.com/coleam00/Archon/tree/archive/v1-stable"
          }
        },
        {
          "insert": " branch."
        }
      ],
      "children": []
    },
