    "b-25-quick-start-the-message-you-pass-to-23": {
      "id": "b-25-quick-start-the-message-you-pass-to-23",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The message you pass to a run is the specification it is measured against. Archon governs how the work happens: isolation, gates, retries and the audit trail. It cannot supply what you wanted. A vague brief produces a confident answer to a question you didn't ask."
        }
      ],
      "children": []
    },
    "b-25-quick-start-wherever-the-run-reads-i-24": {
      "id": "b-25-quick-start-wherever-the-run-reads-i-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Wherever the run reads its input, an issue body, a message or a document, make it state:"
        }
      ],
      "children": []
    },
