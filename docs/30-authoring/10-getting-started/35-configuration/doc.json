      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Set these in your shell, "
        },
        {
          "insert": "~/.archon/.env",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for user-wide settings, or "
        },
        {
          "insert": "<cwd>/.archon/.env",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for project overrides. The CLI strips keys named in a target repository's "
