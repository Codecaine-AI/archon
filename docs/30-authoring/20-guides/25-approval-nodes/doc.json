    "b-25-approval-nodes-yaml-4": {
      "id": "b-25-approval-nodes-yaml-4",
      "type": "code",
      "props": {
        "language": "yaml"
      },
      "text": [
        {
          "insert": "name: plan-review-implement\ndescription: Plan, pause for review, then implement\n\nnodes:\n  - id: plan\n    prompt: |\n      Analyze the codebase and create a detailed implementation plan.\n      $USER_MESSAGE\n\n  - id: review\n    depends_on: [plan]\n    wait:\n      form: approval\n      attention: |\n        Review the plan before implementation starts:\n\n        $plan.output\n\n  - id: stop\n    depends_on: [review]\n    when: \"$review.output.decision == 'reject'\"\n    cancel: The plan was rejected.\n\n  - id: implement\n    depends_on: [review]\n    when: \"$review.output.decision == 'approve'\"\n    prompt: |\n      Implement the plan. Reviewer notes: $review.output.text\n      $plan.output"
        }
      ],
      "children": []
    },
    "b-25-approval-nodes-when-execution-reaches-5": {
      "id": "b-25-approval-nodes-when-execution-reaches-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "When execution reaches "
        },
        {
          "insert": "review",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the run pauses and the question is sent to the\nconversation that started it. The pause is durable: it waits in the attention\nqueue until it is answered, whether the run started in the foreground, with\n"
        },
        {
          "insert": "--detach",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", from the web console, or from a trigger. If the notice cannot be\ndelivered, the run still waits; the failed delivery is logged and recorded on\nthe run as a "
        },
        {
          "insert": "pause_notice_undelivered",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " event. When web push is configured, the\nowner of a run on a chat platform is then notified by push instead, once per pause."
        }
      ],
      "children": []
    },
    "b-25-approval-nodes-reject-is-an-answer-li-6": {
      "id": "b-25-approval-nodes-reject-is-an-answer-li-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "reject",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is an answer like any other and never cancels the run by itself. The\n"
        },
        {
          "insert": "stop",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " node is what ends it; leave it out when a rejection should continue\nsomewhere else."
        }
      ],
      "children": []
    },
