    "b-25-approval-nodes-a-workflow-that-needs-in-1": {
      "id": "b-25-approval-nodes-a-workflow-that-needs-in-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A workflow that needs input pauses at a "
        },
        {
          "insert": "wait: attention",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " node. The run stops,\nthe question waits in the attention queue, and the run continues once someone\nanswers it in the form the node declares. Archon does not route the question or\ncare who answers: a person in the console or chat, an agent through the CLI, or a\nhandler workflow all use the same answer channel."
        }
      ],
      "children": []
    },
    "b-25-approval-nodes-use-it-to-review-a-gener-2": {
      "id": "b-25-approval-nodes-use-it-to-review-a-gener-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Use it to review a generated plan before expensive work, to pick between options\nan agent produced, or to collect instructions mid-run."
        }
      ],
      "children": []
    },
