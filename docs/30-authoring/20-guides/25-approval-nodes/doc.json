      "type": "code",
      "props": {
        "language": "yaml"
      },
      "text": [
        {
          "insert": "- id: refine-plan\n  depends_on: [plan]\n  loop_group:\n    max_iterations: 3\n    until_bash: 'decision=$review.output.decision; [ \"$decision\" = \"approve\" ]'\n    nodes:\n      - id: revise\n        prompt: |\n          Improve this plan: $plan.output\n          Feedback on the previous revision, if any: $LOOP_PREV.review.output.text\n      - id: review\n        depends_on: [revise]\n        wait:\n          form: approval\n          attention: |\n            Review the revised plan:\n\n            $revise.output"
        }
      ],
      "children": []
    },
