      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Check the path",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " -- The directory must be exactly "
        },
        {
          "insert": "~/.archon/workflows/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (a direct child of "
        },
        {
          "insert": "~/.archon/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", not the old double-nested "
        },
        {
          "insert": "~/.archon/.archon/workflows/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ")."
        }
      ],
      "children": []
    },
    "b-50-global-workflows-bash-64": {
      "id": "b-50-global-workflows-bash-64",
      "type": "code",
      "props": {
        "language": "bash"
      },
