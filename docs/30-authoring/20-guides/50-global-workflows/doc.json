    "b-50-global-workflows-shared-commands-scripts-10": {
      "id": "b-50-global-workflows-shared-commands-scripts-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Shared commands/scripts and legacy grouped workflows support one grouping folder. Packaged workflows instead use exactly "
        },
        {
          "insert": "<pack>/<workflow>/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", with one YAML file directly inside the workflow folder."
        }
      ],
      "children": []
    },
    "b-50-global-workflows-text-11": {
      "id": "b-50-global-workflows-text-11",
      "type": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "~/.archon/workflows/\n├── my-review.yaml              # ✅ top-level file\n├── triage/                     # ✅ 1-level subfolder (grouping)\n│   └── weekly-cleanup.yaml     # ✅ resolvable as `weekly-cleanup`\n└── team/                       # ✅ packaged workflow\n    └── personal/\n        └── personal.yaml       # exactly one direct YAML is required"
        }
      ],
      "children": []
    },
    "b-50-global-workflows-yaml-nested-below-the-wo-12": {
      "id": "b-50-global-workflows-yaml-nested-below-the-wo-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "YAML nested below the workflow folder is not loaded. Inside a pack, a folder with no direct YAML (tests, docs, assets) and any dot directory ("
        },
        {
          "insert": ".shared",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": ".github",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") are not workflow folders and are skipped. A folder with two or more direct YAML files is reported as invalid rather than ignored silently."
        }
      ],
      "children": []
    },
    "b-50-global-workflows-commands-resolve-by-fi-13": {
      "id": "b-50-global-workflows-commands-resolve-by-fi-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Commands resolve by "
        },
        {
          "insert": "filename without extension",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". Project, global, and bundled workflows launch and compose by their exact, case-sensitive YAML "
        },
        {
          "insert": "name:",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", regardless of which subfolder the file lives in. Launch "
        },
        {
          "insert": "installed pack entrypoints",
          "attributes": {
            "link": "#installed-workflow-packs"
          }
        },
        {
          "insert": " by their qualified "
        },
        {
          "insert": "owner/plugin:entrypoint",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " name; references within that pack can use the YAML "
        },
        {
          "insert": "name:",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Duplicate basenames within the same scope are a user error -- keep each name unique within "
        },
        {
          "insert": "~/.archon/commands/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (or "
        },
        {
          "insert": "<repoRoot>/.archon/commands/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), across whatever subfolders you use."
        }
      ],
      "children": []
    },
