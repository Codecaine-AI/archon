    "b-50-global-workflows-workflows-placed-in-1": {
      "id": "b-50-global-workflows-workflows-placed-in-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Workflows placed in "
        },
        {
          "insert": "~/.archon/workflows/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", commands in "
        },
        {
          "insert": "~/.archon/commands/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and scripts in "
        },
        {
          "insert": "~/.archon/scripts/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " are loaded globally -- they appear in every project and can be invoked from any repository. Repo-specific files take precedence over home-scoped files with the same name."
        }
      ],
      "children": []
    },
    "b-50-global-workflows-paths-2": {
