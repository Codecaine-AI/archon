      },
      "text": [
        {
          "insert": "Syncing with Dotfiles"
        }
      ],
      "children": []
    },
    "b-50-global-workflows-if-you-manage-your-confi-46": {
      "id": "b-50-global-workflows-if-you-manage-your-confi-46",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "If you manage your configuration with a dotfiles repository, you can include your global content:"
        }
      ],
      "children": []
    },
    "b-50-global-workflows-bash-47": {
      "id": "b-50-global-workflows-bash-47",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "# In your dotfiles repo\ndotfiles/\n└── archon/\n    ├── workflows/\n    │   ├── my-review.yaml\n    │   └── explain.yaml\n    └── commands/\n        └── review-checklist.md"
        }
      ],
      "children": []
    },
    "b-50-global-workflows-then-symlink-during-dotf-48": {
      "id": "b-50-global-workflows-then-symlink-during-dotf-48",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Then symlink during dotfiles setup:"
        }
      ],
      "children": []
    },
    "b-50-global-workflows-bash-49": {
      "id": "b-50-global-workflows-bash-49",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "ln -sf ~/dotfiles/archon/workflows ~/.archon/workflows\nln -sf ~/dotfiles/archon/commands  ~/.archon/commands"
        }
      ],
      "children": []
    },
    "b-50-global-workflows-or-copy-them-as-part-of-50": {
      "id": "b-50-global-workflows-or-copy-them-as-part-of-50",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Or copy them as part of your dotfiles install script:"
        }
      ],
      "children": []
    },
    "b-50-global-workflows-bash-51": {
      "id": "b-50-global-workflows-bash-51",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "mkdir -p ~/.archon/workflows ~/.archon/commands\ncp ~/dotfiles/archon/workflows/*.yaml ~/.archon/workflows/\ncp ~/dotfiles/archon/commands/*.md    ~/.archon/commands/"
        }
      ],
      "children": []
    },
    "b-50-global-workflows-this-way-your-personal-w-52": {
      "id": "b-50-global-workflows-this-way-your-personal-w-52",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This way your personal workflows and commands travel with you across machines."
        }
      ],
      "children": []
    },
    "b-50-global-workflows-cli-and-web-support-53": {
      "id": "b-50-global-workflows-cli-and-web-support-53",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "CLI and Web Support"
        }
      ],
      "children": []
    },
    "b-50-global-workflows-the-cli-server-and-web-54": {
      "id": "b-50-global-workflows-the-cli-server-and-web-54",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The CLI, server, and Web UI discover home-scoped content automatically -- no flag, no config option."
        }
      ],
      "children": []
    },
    "b-50-global-workflows-bash-55": {
      "id": "b-50-global-workflows-bash-55",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "# Lists bundled + global + repo-specific workflows\narchon workflow list\n\n# Run a global workflow from any repo\narchon workflow run my-review"
        }
      ],
      "children": []
    },
    "b-50-global-workflows-in-the-web-ui-workflow-b-56": {
      "id": "b-50-global-workflows-in-the-web-ui-workflow-b-56",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "In the Web UI workflow builder, add a command node and enter the command name in\nthe inspector. The builder does not currently provide source-grouped command\nbrowsing."
        }
      ],
      "children": []
    },
    "b-50-global-workflows-migrating-from-the-old-p-57": {
      "id": "b-50-global-workflows-migrating-from-the-old-p-57",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Migrating from the old path"
        }
      ],
      "children": []
    },
    "b-50-global-workflows-earlier-versions-of-arch-58": {
      "id": "b-50-global-workflows-earlier-versions-of-arch-58",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Earlier versions of Archon stored global workflows at "
        },
        {
          "insert": "~/.archon/.archon/workflows/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "\n(with an extra nested "
        },
        {
          "insert": ".archon/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). Archon no longer reads that location or warns about\nit, and does not migrate workflows automatically. Set "
        },
        {
          "insert": "ARCHON_HOME",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in your shell to\nyour Archon home (default "
        },
        {
          "insert": "~/.archon",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). If "
        },
        {
          "insert": "$ARCHON_HOME/workflows",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " does not exist, move\nthe old directory:"
        }
      ],
      "children": []
    },
    "b-50-global-workflows-bash-59": {
      "id": "b-50-global-workflows-bash-59",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "mv \"$ARCHON_HOME/.archon/workflows\" \"$ARCHON_HOME/workflows\""
        }
      ],
      "children": []
    },
    "b-50-global-workflows-if-the-destination-alrea-60": {
      "id": "b-50-global-workflows-if-the-destination-alrea-60",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "If the destination already exists, merge the files manually, checking for name conflicts.\nThere was no prior home-scoped commands location, so "
        },
        {
          "insert": "~/.archon/commands/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " has nothing\nto migrate."
        }
      ],
      "children": []
    },
    "b-50-global-workflows-troubleshooting-61": {
      "id": "b-50-global-workflows-troubleshooting-61",
      "type": "heading",
      "props": {
        "level": 2
      },
