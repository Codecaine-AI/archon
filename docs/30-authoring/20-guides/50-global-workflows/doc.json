    "b-50-global-workflows-note-on-location-th-8": {
      "id": "b-50-global-workflows-note-on-location-th-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Note on location.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " These are direct children of "
        },
        {
          "insert": "~/.archon/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " -- same level as "
        },
        {
          "insert": "workspaces/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "archon.db",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "config.yaml",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Earlier Archon versions stored global workflows at "
        },
        {
          "insert": "~/.archon/.archon/workflows/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; see "
        },
        {
          "insert": "Migrating from the old path",
          "attributes": {
            "link": "#migrating-from-the-old-path"
          }
        },
