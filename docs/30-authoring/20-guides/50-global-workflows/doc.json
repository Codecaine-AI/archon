    "b-50-global-workflows-a-workflow-pack-publishe-20": {
      "id": "b-50-global-workflows-a-workflow-pack-publishe-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A workflow pack published on GitHub installs for every project on this Archon with "
        },
        {
          "insert": "archon plugin add",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "doc",
              "path": "docs/10-system-design/10-reference/20-cli.md",
              "section": "plugin",
              "label": "`archon plugin add`"
            }
          }
        },
        {
          "insert": ". Installed packs are a fourth source next to bundled, global and project, outside the precedence above."
        }
      ],
      "children": []
    },
    "b-50-global-workflows-a-plugin-root-is-a-direc-21": {
      "id": "b-50-global-workflows-a-plugin-root-is-a-direc-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A plugin root is a directory containing "
        },
        {
          "insert": "archon-plugin.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and one pack in the packaged layout. A repository can contain one or more plugin roots, at the repository root or in subdirectories. Each root installs independently using "
        },
        {
          "insert": "owner/repo[/path]",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". This example shows a single plugin root:"
        }
      ],
      "children": []
    },
    "b-50-global-workflows-text-22": {
      "id": "b-50-global-workflows-text-22",
      "type": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "review-kit/                     # plugin root: owner/repo or owner/repo/<path>\n├── archon-plugin.json\n├── .shared/                    # modules and documents the pack's scripts use\n│   ├── metric-views.json       # optional overview cards for the console\n│   └── util.ts\n├── .github/workflows/ci.yml    # a dot directory: never a workflow folder\n├── tests/                      # no direct YAML: not a workflow folder\n├── review/                     # an entrypoint\n│   ├── review.yaml\n│   ├── commands/scope.md\n│   └── scripts/check.ts\n└── helper/                     # a support workflow\n    ├── helper.yaml\n    └── commands/summarize.md"
        }
      ],
      "children": []
    },
    "b-50-global-workflows-the-whole-plugin-directo-23": {
      "id": "b-50-global-workflows-the-whole-plugin-directo-23",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The whole plugin directory is installed, so a pack at the repository root can keep its CI configuration, tests and README next to its workflows. Only folders holding exactly one direct YAML file load as workflows."
        }
      ],
      "children": []
    },
