    "b-50-global-workflows-support-workflows-e-26": {
      "id": "b-50-global-workflows-support-workflows-e-26",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Support workflows.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Every workflow that is not an entrypoint is support. An entrypoint uses it with "
        },
        {
          "insert": "include:",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (by its YAML "
        },
        {
          "insert": "name:",
