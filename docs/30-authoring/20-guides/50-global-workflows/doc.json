    },
    "b-50-global-workflows-check-file-extension-65": {
      "id": "b-50-global-workflows-check-file-extension-65",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Check file extension",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " -- Workflow files must end in "
        },
        {
          "insert": ".yaml",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": ".yml",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-50-global-workflows-check-yaml-validity-66": {
      "id": "b-50-global-workflows-check-yaml-validity-66",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Check YAML validity",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " -- A syntax error in the YAML will cause the workflow to appear in the errors list rather than the workflow list. Run:"
        }
      ],
      "children": []
    },
    "b-50-global-workflows-bash-67": {
      "id": "b-50-global-workflows-bash-67",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "archon validate workflows my-workflow"
        }
      ],
      "children": []
    },
    "b-50-global-workflows-check-for-name-conflic-68": {
      "id": "b-50-global-workflows-check-for-name-conflic-68",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Check for name conflicts",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " -- If a repo-specific workflow has the same filename, it overrides the global one. The global version will not appear when you are in that repo."
        }
      ],
      "children": []
    },
    "b-50-global-workflows-check-archon-home-69": {
      "id": "b-50-global-workflows-check-archon-home-69",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Check ARCHON_HOME",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " -- If you have set "
        },
        {
          "insert": "ARCHON_HOME",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to a custom path, global workflows must be at "
        },
        {
          "insert": "$ARCHON_HOME/workflows/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", not "
        },
        {
          "insert": "~/.archon/workflows/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    }
  }
}
