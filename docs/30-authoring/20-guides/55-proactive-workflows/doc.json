    "b-55-proactive-workflows-a-run-waiting-at-review-18": {
      "id": "b-55-proactive-workflows-a-run-waiting-at-review-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A run waiting at "
        },
        {
          "insert": "review",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is "
        },
        {
          "insert": "paused",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and it gives its resource slot back while it waits, so unreviewed drafts do not block later issues. "
        },
        {
          "insert": "capacity: 3",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " bounds how many investigations execute at once. When a draft is approved, its run continues ahead of queued issues once a slot frees. This needs a continuation host: "
        },
        {
          "insert": "archon serve",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or "
        },
        {
          "insert": "archon workflow wake --watch",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " beside the trigger host. See "
        },
        {
          "insert": "resource, capacity, and overlap",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/30-authoring/20-guides/60-workflow-triggers.md",
              "section": "choose-a-resource-capacity-and-overlap-policy",
              "label": "resource, capacity, and overlap"
            }
          }
        },
