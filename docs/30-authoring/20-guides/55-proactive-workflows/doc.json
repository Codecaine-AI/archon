    "b-55-proactive-workflows-a-proactive-workflow-sta-1": {
      "id": "b-55-proactive-workflows-a-proactive-workflow-sta-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A proactive workflow starts without anyone asking. An event arrives, an agent decides whether it matters, another agent does the work, and the run pauses until its result is approved before Archon acts on it. Whoever answers reviews finished work instead of starting each run."
        }
      ],
      "children": []
    },
