    "b-55-proactive-workflows-to-run-the-same-pattern-20": {
      "id": "b-55-proactive-workflows-to-run-the-same-pattern-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "To run the same pattern on a timer instead, use a "
        },
        {
          "insert": "schedule binding",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/30-authoring/20-guides/60-workflow-triggers.md",
              "section": "configure-a-native-macos-schedule",
              "label": "schedule binding"
            }
          }
        },
        {
          "insert": ". A schedule has no event to map from, so the workflow's first node has to find its own work, such as listing issues opened since the last run. Keep that cursor in a "
        },
        {
          "insert": "durable state document",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/10-system-design/10-reference/35-workflow-language.md",
              "section": "durable-state-documents",
              "label": "durable state document"
            }
          }
        },
        {
