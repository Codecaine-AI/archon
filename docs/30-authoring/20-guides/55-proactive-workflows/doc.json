        {
          "insert": " reads the issue on the "
        },
        {
          "insert": "small",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " tier and returns "
        },
        {
          "insert": "route",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " ("
        },
        {
          "insert": "investigate",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "skip",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") and a one-sentence "
        },
        {
          "insert": "reason",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Most issues need no investigation, so the cheap model reads every issue and the stronger model reads only the ones routed onward."
        }
