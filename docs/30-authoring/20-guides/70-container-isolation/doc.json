            "In-process harness; needs a container tool-transport (Flue-style) or an in-image shim."
          ],
          [
            [
              {
                "insert": "OpenCode / Copilot / community",
                "attributes": {
                  "bold": true
                }
              }
            ],
            "🔜",
            [
              {
                "insert": "Declare "
              },
              {
                "insert": "containerExec: true",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " and implement their own exec-in-container translation against the "
              },
              {
                "insert": "ExecutionContext",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " contract."
              }
            ]
          ]
        ]
      },
