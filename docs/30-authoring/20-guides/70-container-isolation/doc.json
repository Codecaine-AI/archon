    },
    "b-70-container-isolation-archon-isolation-list-28": {
      "id": "b-70-container-isolation-archon-isolation-list-28",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "archon isolation list",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " shows active container environments with their age. "
        },
        {
          "insert": "archon isolation cleanup",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " reaps containers and volumes older than the threshold only when no claimable run owns the environment and platform policy permits removal. It preserves containers for pending, running, paused, and resumable failed runs, including failed resume setup. The displayed run status or "
        },
        {
          "insert": "no run (orphan)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " label does not establish eligibility: cleanup checks run metadata, conversation links, and same-codebase checkout paths. If that ownership lookup fails, cleanup reports the error and skips removal. To discard a failed run and its retry overlay, use "
        },
        {
          "insert": "archon workflow abandon <run-id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
