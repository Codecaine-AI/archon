              "kind": "doc",
              "path": "docs/10-system-design/10-reference/55-configuration.md",
              "section": "container-isolation-folder-projects",
              "label": "configuration"
            }
          }
        },
        {
          "insert": " for the "
        },
        {
          "insert": "container:",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " config block (image, network, memory, pids) and the "
        },
        {
          "insert": "container.write_back",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " workflow policy."
        }
      ],
