    "b-70-container-isolation-folder-projects-docs-1": {
      "id": "b-70-container-isolation-folder-projects-docs-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Folder projects",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/30-authoring/20-guides/65-multi-repo-projects.md",
              "label": "Folder projects"
            }
          }
        },
        {
          "insert": " (directories with or without git, where Archon applies no git machinery) run "
        },
        {
          "insert": "in place",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " at the live root by default: every write lands immediately. That is honest but ungoverned, and unsafe for unattended automation against real client data. "
        },
        {
          "insert": "Container isolation",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " runs the whole workflow inside a Docker container over a "
        },
        {
          "insert": "read-only mount of the project root plus a writable overlay upper layer",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", so nothing touches the live folder until you approve it."
        }
      ],
      "children": []
    },
    "b-70-container-isolation-this-is-folder-project-o-2": {
      "id": "b-70-container-isolation-this-is-folder-project-o-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This is folder-project-only. Repo projects use "
        },
        {
          "insert": "git worktrees",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/30-authoring/20-guides/15-worktrees.md",
              "label": "git worktrees"
            }
          }
        },
        {
          "insert": " and are unaffected."
        }
      ],
      "children": []
    },
    "b-70-container-isolation-how-it-works-3": {
      "id": "b-70-container-isolation-how-it-works-3",
      "type": "heading",
