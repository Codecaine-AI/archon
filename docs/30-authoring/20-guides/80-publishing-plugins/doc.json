    "b-80-publishing-plugins-github-is-the-registry-1": {
      "id": "b-80-publishing-plugins-github-is-the-registry-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "GitHub is the registry. Publish in your own public repository, then add the "
        },
        {
          "insert": "archon-plugin",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " repository topic to appear in the "
        },
        {
          "insert": "plugin index",
          "attributes": {
            "link": "https://archon.diy/plugins/"
          }
        },
        {
          "insert": ". No Archon pull request, Archon account, or publication service is required. Listing is optional: "
        },
        {
          "insert": "archon plugin add owner/repo[/path][@tag]",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " works independently of the index."
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-workflow-packs-2": {
      "id": "b-80-publishing-plugins-workflow-packs-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Workflow packs"
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-place-archon-plugin-jso-3": {
      "id": "b-80-publishing-plugins-place-archon-plugin-jso-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Place "
        },
        {
          "insert": "archon-plugin.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in your plugin root, either the repository root or a subdirectory. A repository can contain several plugins. Each manifest-bearing directory gets its own listing and install ID, such as "
        },
        {
          "insert": "acme/tools/packs/review-kit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-json-4": {
      "id": "b-80-publishing-plugins-json-4",
      "type": "code",
      "props": {
        "language": "json"
      },
      "text": [
        {
          "insert": "{\n  \"schemaVersion\": 1,\n  \"kind\": \"workflow-pack\",\n  \"name\": \"review-kit\",\n  \"description\": \"Review workflows\",\n  \"compatibility\": { \"archon\": \">=0.11.0\" },\n  \"entrypoints\": { \"review\": \"review/review.yaml\" }\n}"
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-use-lowercase-words-join-5": {
      "id": "b-80-publishing-plugins-use-lowercase-words-join-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Use lowercase words joined by hyphens for "
        },
        {
          "insert": "name",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and entrypoint names. Each entrypoint path is "
        },
        {
          "insert": "<workflow folder>/<file>.yaml",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (or "
        },
        {
          "insert": ".yml",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), relative to the plugin root. Other workflows are support workflows and cannot be dispatched directly. See the "
        },
        {
          "insert": "pack layout and runtime identity",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/30-authoring/20-guides/50-global-workflows.md",
              "section": "installed-workflow-packs",
              "label": "pack layout and runtime identity"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-the-manifest-is-strict-6": {
      "id": "b-80-publishing-plugins-the-manifest-is-strict-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The manifest is strict. Do not add version, credentials, install scripts, dependencies, or permission grants. "
        },
        {
          "insert": "compatibility.archon",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is optional; when supplied, installation checks it. Put prerequisites and usage instructions in a "
        },
        {
          "insert": "README.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " alongside the manifest. The index links to the README on GitHub; it does not execute plugin code or embed author-supplied HTML."
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-tags-and-executable-rele-7": {
      "id": "b-80-publishing-plugins-tags-and-executable-rele-7",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Tags and executable release assets"
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-git-tags-are-versions-f-8": {
      "id": "b-80-publishing-plugins-git-tags-are-versions-f-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Git tags are versions. For workflow packs, an untagged install resolves the default branch head and freezes its commit. Publish a tag to let operators choose a version:"
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-bash-9": {
      "id": "b-80-publishing-plugins-bash-9",
      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "archon plugin add acme/tools/packs/review-kit@v1.0.0"
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-a-forge-plugin-declares-10": {
      "id": "b-80-publishing-plugins-a-forge-plugin-declares-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A forge plugin declares an executable instead of workflow entrypoints:"
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-json-11": {
      "id": "b-80-publishing-plugins-json-11",
      "type": "code",
      "props": {
        "language": "json"
      },
      "text": [
