          "insert": "{\n  \"schemaVersion\": 1,\n  \"kind\": \"forge\",\n  \"name\": \"example-forge\",\n  \"description\": \"Example forge integration\",\n  \"executable\": \"archon-forge-example\"\n}"
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-publish-a-github-release-12": {
      "id": "b-80-publishing-plugins-publish-a-github-release-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Publish a GitHub release with "
        },
        {
          "insert": "<executable>-<os>-<arch>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " assets ("
        },
        {
          "insert": ".exe",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on Windows), and "
        },
        {
          "insert": "checksums.txt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "sha256sum",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " format covering the asset names. Supported platform names are "
        },
        {
          "insert": "linux",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "darwin",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "windows",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; architectures are "
        },
        {
          "insert": "x64",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "arm64",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Build assets for the platforms you support. An untagged forge install uses the latest GitHub release. A tag without the required platform asset cannot install on that platform. Checksums detect damaged downloads; they do not establish publisher trust."
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-provider-plugins-13": {
      "id": "b-80-publishing-plugins-provider-plugins-13",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Provider plugins"
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-a-provider-plugin-runs-a-14": {
      "id": "b-80-publishing-plugins-a-provider-plugin-runs-a-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A provider plugin runs agent sessions in a separate process. Publish the implementation\nin your own repository with this manifest at its root or an installable subdirectory:"
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-json-15": {
      "id": "b-80-publishing-plugins-json-15",
      "type": "code",
      "props": {
        "language": "json"
      },
      "text": [
        {
          "insert": "{\n  \"schemaVersion\": 1,\n  \"kind\": \"provider\",\n  \"name\": \"example-provider\",\n  \"description\": \"Example agent provider\",\n  \"executable\": \"archon-provider-example\",\n  \"compatibility\": { \"archon\": \">=0.11.1\" }\n}"
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-the-executable-suffix-is-16": {
      "id": "b-80-publishing-plugins-the-executable-suffix-is-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The executable suffix is the provider id: "
        },
        {
          "insert": "archon-provider-example",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " must return\n"
        },
        {
          "insert": "id: \"example\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in its descriptor. Publish release assets and "
        },
        {
          "insert": "checksums.txt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with\nthe same naming rules as forge plugins, for example "
        },
        {
          "insert": "archon-provider-example-linux-x64",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "\nand "
        },
        {
          "insert": "archon-provider-example-windows-x64.exe",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Without "
        },
        {
          "insert": "@tag",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", install and update\nselect the latest GitHub release."
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-sh-17": {
      "id": "b-80-publishing-plugins-sh-17",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "archon plugin add owner/repo\narchon plugin list\narchon plugin update owner/repo\narchon plugin remove owner/repo"
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-install-verifies-the-che-18": {
      "id": "b-80-publishing-plugins-install-verifies-the-che-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Install verifies the checksum, starts the staged executable, validates its descriptor,\nand records that descriptor in the receipt. An invalid handshake, id collision,\nunsupported capability, or undeliverable API-key vendor leaves the previous install\nunchanged. Hosts register receipts without starting the executables at boot; each\nsession checks the live descriptor against the installed one. Restart a running server\nafter installing, updating, or removing a provider. A new CLI process sees it immediately.\nA workflow can then name the descriptor id in "
        },
        {
          "insert": "provider:",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-provider-plugins-execute-19": {
      "id": "b-80-publishing-plugins-provider-plugins-execute-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Provider plugins execute code as your operating-system user. On the host they receive\nthe ambient environment plus Archon's per-request environment, just like an in-process\nprovider. For container execution the plugin still inherits the host environment so it\ncan launch the container runtime; the container request environment travels as session\ndata and becomes the provider's "
        },
        {
          "insert": "options.env",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Credential checks use the plugin process\nenvironment.\nThe process boundary supplies packaging, crash isolation, and cancellation; it is not a\nsecurity sandbox. Archon withholds plugin stderr contents from its logs and errors because\nthey may contain credentials or user messages."
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-native-tool-specificatio-20": {
      "id": "b-80-publishing-plugins-native-tool-specificatio-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Native tool specifications travel with the session; their handlers run in the host\nthrough "
        },
        {
          "insert": "_archon/tool_call",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Calls after settlement or cancellation are rejected.\n"
        },
        {
          "insert": "serveProvider",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " passes a structured log sink to its "
        },
        {
          "insert": "create(log)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " factory. Await that\nsink with "
        },
        {
          "insert": "{ level, msg, bindings }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to send metadata through "
        },
        {
          "insert": "_archon/log",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ".\nThe host logs "
        },
        {
          "insert": "provider.plugin.log",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " at the supplied severity through "
        },
        {
          "insert": "provider.<id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ",\nusing its own descriptor id. Set "
        },
        {
          "insert": "bindings.failureClass",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to one of the contract's failure\nclasses, or "
        },
        {
          "insert": "bindings.lifecycle",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to one of its lifecycle events\n("
        },
        {
          "insert": "providerLifecycleEventSchema",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), on any record the operator should see. With a lifecycle\nevent, a non-negative integer "
        },
        {
          "insert": "bindings.waitedMs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is forwarded too. The host forwards\nthose values and nothing else, and drops a record with neither enum value. "
        },
        {
          "insert": "msg",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", plugin module identity, and all\nother bindings remain withheld. Never put credentials, tokens, or message text in log\nrecords. Keep stdout exclusively for RPC; configure other logging to stderr before\nit writes. Stderr remains withheld."
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-see-building-a-communit-21": {
      "id": "b-80-publishing-plugins-see-building-a-communit-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "See "
        },
        {
          "insert": "building a community provider",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/20-implementation/10-contributing/50-adding-a-community-provider.md",
              "label": "building a community provider"
            }
          }
        },
        {
          "insert": " for\n"
        },
        {
          "insert": "serveProvider",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", descriptors, wire schemas, and conformance tests."
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-provider-receipts-are-ad-22": {
      "id": "b-80-publishing-plugins-provider-receipts-are-ad-22",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Provider receipts are additive, but older Archon binaries reject their unknown kind.\nRemove provider plugins before downgrading to a release without provider-plugin support."
        }
      ],
      "children": []
    },
    "b-80-publishing-plugins-chat-plugins-23": {
